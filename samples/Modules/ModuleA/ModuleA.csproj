<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <IsPackable>False</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <Import Project="..\..\..\build\Avalonia.props" />
    <Import Project="..\..\..\build\Prism.Avalonia.props" />

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\DynamicLocalization.Avalonia\DynamicLocalizationUI.Avalonia.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Language.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Language.resx</DependentUpon>
        </Compile>
        <EmbeddedResource Update="Properties\Language.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Language.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>
</Project>